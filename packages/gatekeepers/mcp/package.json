{
  "name": "@operon/gatekeeper-mcp",
  "version": "0.0.0",
  "description": "The generic MCP Gatekeeper (spec 0008 §5): fronts remote MCP servers, portal-first. Upstream credentials live here or in Cloudflare One, never in the container, and one classification module decides which tools an agent may call.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@operon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "dev": {
        "command": "wrangler dev",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      }
    }
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@operon/core": "0.0.0",
    "@operon/worker-kit": "0.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "wrangler": "^4.118.0"
  }
}
