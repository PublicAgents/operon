{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "operon-gatekeeper-spend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // INVARIANT (spec 0002 §4.12): this Worker joins no private network,
  // ever. Rebinding a hostname must buy an attacker nothing a public
  // request could not already reach.
  "durable_objects": {
    "bindings": [
      { "name": "SPEND", "class_name": "SpendLedger" },
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpendLedger", "Ledger"] }],
  "vars": {
    // ROSTER injected at deploy. Colony caps in display units of the
    // payment currency; the platform-side scoped-key limits sit BELOW
    // these as the second bound (spec 0002 §2.2).
    "SPEND_MAX_TX": "0.10",
    "SPEND_DAILY_CAP": "1.00",
    "SPEND_TESTNET": "true"
  }
  // Secrets:
  //   MPP_PRIVATE_KEY        the payment key; exists ONLY here; scoped
  //                          access key with platform limits in production
  //   NOTIFY_TOKEN           telegram Gatekeeper bearer (holds, receipts)
  //   OPERATOR_API_TOKEN     approve/reject/reconcile/outbox/ledger
  //   SPEND_TOKEN_<AGENTID>  per-agent bearers (identity from the bearer)
}
