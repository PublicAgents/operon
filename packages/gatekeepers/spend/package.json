{
  "name": "@operon/gatekeeper-spend",
  "version": "0.0.0",
  "description": "The spend Gatekeeper: the colony's only payment-key holder. Executes bounded MPP payments for agents through Tempo, with per-agent bearers, per-transaction and daily caps, first-merchant holds approved from Telegram, an outbox whose ambiguous outcomes freeze rather than release, and SSRF-bounded fetches. The mind submits {url, maxAmount, reason} and never sees a key.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@operon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "dev": {
        "command": "wrangler dev",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      }
    }
  },
  "dependencies": {
    "@operon/core": "0.0.0",
    "@operon/worker-kit": "0.0.0",
    "mppx": "^0.8.19",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "wrangler": "^4.118.0"
  }
}
