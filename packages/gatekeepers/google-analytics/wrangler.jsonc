{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "operon-gatekeeper-google-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }]
  // ROSTER injected at deploy; the fleet templates own the real
  // deployment config (spec 0006 §2). This file is the dev target.
  // Vars:    GA_PROPERTY_ID  the one property every query is pinned to
  // Secrets: GA_SERVICE_ACCOUNT  the service-account JSON key. Its only
  //          power is Viewer on that property, granted at the Google
  //          side: the read-only fence is there, not here.
}
