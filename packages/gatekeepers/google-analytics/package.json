{
  "name": "@operon/gatekeeper-google-analytics",
  "version": "0.0.0",
  "description": "The Google Analytics Gatekeeper (spec 0008 \u00a75): read-only GA Data API reporting, spoken as MCP. Holds the service-account key so the wake container never does, and pins every query to the operator-configured property.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@operon/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "dev": {
        "command": "wrangler dev",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@operon/worker-kit": "0.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "wrangler": "^4.118.0"
  }
}
