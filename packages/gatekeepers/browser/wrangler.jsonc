{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "operon-gatekeeper-browser",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "WEB_SESSION", "class_name": "WebSession" },
      { "name": "WEB_METER", "class_name": "WebMeter" },
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  // v1 shipped with the relay; WebMeter is a NEW class and needs its own
  // tag: adding it to an applied migration would never register it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WebSession", "Ledger"] },
    { "tag": "v2", "new_sqlite_classes": ["WebMeter"] }
  ]
  // No routes and no workers_dev: a service binding is the only way in
  // (binding-only auth; identity is x-operon-agent from the umbilical).
  // Vars: CF_ACCOUNT_ID, WEB_ORIGIN_DENYLIST, WEB_MAX_CONCURRENT.
  // Secrets: BROWSER_RUN_TOKEN (Cloudflare API token, Browser Run perm).
  // The CDP provider is CONFIGURATION (provider.ts): Cloudflare Browser
  // Run is the default, built from the two values above. Any other CDP
  // endpoint plugs in with no code change:
  //   WEB_CDP_ENDPOINT   full wss/https CDP URL of the provider
  //   WEB_CDP_TOKEN      (secret) optional bearer for that endpoint
  //   WEB_CDP_PROVIDER   display name; "cloudflare" enables vendor live view
  // Everything behind the dial is plain CDP; web_screenshot works on any
  // provider, web_live_view needs the vendor command.
}
