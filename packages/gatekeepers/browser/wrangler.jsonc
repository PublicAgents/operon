{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "operon-gatekeeper-browser",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "WEB_SESSION", "class_name": "WebSession" },
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebSession", "Ledger"] }]
  // No routes and no workers_dev: the scheduler's service binding is the
  // only way in (binding-only auth; identity is x-operon-agent from the
  // umbilical). Vars: CF_ACCOUNT_ID.
  // Secrets: BROWSER_RUN_TOKEN (Cloudflare API token, Browser Run perm).
}
