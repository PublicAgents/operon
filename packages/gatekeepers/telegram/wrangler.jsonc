{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "operon-gatekeeper-telegram",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "LEDGER",
        "class_name": "Ledger"
      },
      {
        "name": "CHANNEL",
        "class_name": "Channel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Ledger"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Channel"]
    }
  ],
  // The notifications feed and the channel/ledger mirrors (spec 0005 §5)
  // record into the chronicle D1; a deployment without this binding
  // silently loses every notify a missing Telegram would have carried.
  "d1_databases": [
    {
      "binding": "CHRONICLE",
      "database_name": "operon-chronicle",
      "database_id": "operon-chronicle-local",
      "migrations_dir": "../../chronicle/migrations"
    }
  ]
  // Secrets, set per deployment (wrangler secret put):
  //   TELEGRAM_BOT_TOKEN        the bot's API token
  //   TELEGRAM_WEBHOOK_SECRET   secret_token registered with setWebhook
  //   NOTIFY_TOKEN              bearer accepted on POST /notify
  //   WAKE_TRIGGER_TOKEN        bearer this Gatekeeper presents to the scheduler
  //   EMAIL_SERVICE_TOKEN       bearer for the email Gatekeeper (approve/reject
  //                             held sends from the inline buttons)
  // Vars, set per deployment:
  //   OPERATOR_CHAT_ID          the one chat identity that is the operator
  // Service bindings, set per deployment:
  //   SCHEDULER                 the scheduler Worker (manual wakes)
}
