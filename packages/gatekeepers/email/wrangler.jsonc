{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "operon-gatekeeper-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The wake reaches /send, /pull, /approve over HTTPS, so a public host.
  // Inbound mail arrives via an Email Routing rule (configured in the
  // dashboard) that points the agents.<zone> catch-all at this Worker.
  // No route here: wake traffic uses the private umbilical service binding,
  // while inbound Email Routing targets this Worker by name. Nothing
  // deployment-specific belongs in this file.
  "workers_dev": false,
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox", "Ledger"] }],
  "vars": {
    // ROSTER is passed by the fleet deploy. EMAIL_DOMAIN is the subdomain
    // whose MX routes to this Worker (NOT the apex); the templates set
    // it per deployment, and this placeholder never receives mail.
    "EMAIL_DOMAIN": "agents.example.invalid"
  }
  // Secrets (wrangler secret put -c workers/gatekeeper-email/wrangler.jsonc):
  //   EMAIL_SERVICE_TOKEN   internal bearer the wake presents (send/pull/approve)
  //   NOTIFY_TOKEN          bearer for the telegram Gatekeeper /notify
  //   OPERATOR_EMAIL        optional: fixed operator copy address; if unset,
  //                         copies go to <agent-name>@<zone> (catch-all)
  // Vars set per deployment: NOTIFY_URL (telegram Gatekeeper /notify).
}
