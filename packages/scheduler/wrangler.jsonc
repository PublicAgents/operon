{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "operon-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Deployments register every distinct cadence in the roster here; the
  // scheduled handler matches agents by the exact cron string that fired.
  "triggers": {
    "crons": ["0 6,12,18 * * *"]
  },
  "containers": [
    {
      "class_name": "WakeContainer",
      "image": "../container/Dockerfile",
      "max_instances": 4,
      // Platform floor: at least 3 GiB memory per vCPU (first 4 vCPUs);
      // the headroom also fits the workload (agent tooling is
      // memory-hungry, and OOM kills look like flakiness).
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 4000
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WAKE_CONTAINER",
        "class_name": "WakeContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WakeContainer"]
    }
  ],
  "vars": {
    // Deployments override with their real roster JSON.
    "ROSTER": "{\"zone\":\"example-colony.com\",\"agents\":[]}"
  },
  // Wake outcomes and egress summaries mirror into the chronicle
  // (CHRONICLE_DB, because CHRONICLE is the gatekeeper service binding
  // in deployments). Optional: absent, the mirrors are skipped.
  "d1_databases": [
    {
      "binding": "CHRONICLE_DB",
      "database_name": "operon-chronicle",
      "database_id": "operon-chronicle-local"
    }
  ]
  // Secrets, set per deployment (wrangler secret put):
  //   WAKE_TRIGGER_TOKEN        bearer for POST /wake/:agentId and GET /wakes/:agentId
  //   MIND_CREDENTIAL_CLAUDE_CODE  subscription OAuth token for claude-code minds
  //   GITHUB_TOKEN_SERVICE_TOKEN   bearer presented to the github Gatekeeper
  //   NOTIFY_TOKEN              bearer the container uses against the telegram Gatekeeper
  // Vars, set per deployment:
  //   NOTIFY_URL                telegram Gatekeeper /notify endpoint
  //   SECRET_DENYLIST           comma-separated literals for the presleep sweep
  //   HARNESS_EXTRA_ARGS        JSON array of extra harness CLI args; operator-owned
  //                             session policy (e.g. permission settings)
  // Service bindings, set per deployment:
  //   GITHUB_GATEKEEPER         the github Gatekeeper Worker (mints state-repo tokens)
}
